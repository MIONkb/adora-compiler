#map = affine_map<(d0, d1) -> (d0, d1)>
#map1 = affine_map<(d0, d1) -> (d1)>
module {
  ml_program.global private mutable @global_seed(dense<0> : tensor<i64>) : tensor<i64>
  func.func @main(%arg0: tensor<64x128xf32>) -> tensor<64x64xf32> {
    %cst = arith.constant dense_resource<torch_tensor_64_128_torch.float32> : tensor<64x128xf32>
    %cst_0 = arith.constant 0.000000e+00 : f32
    %cst_1 = arith.constant dense_resource<torch_tensor_64_torch.float32> : tensor<64xf32>
    %0 = tensor.empty() : tensor<128x64xf32>
    %transposed = linalg.transpose ins(%cst : tensor<64x128xf32>) outs(%0 : tensor<128x64xf32>) permutation = [1, 0] 
    %1 = tensor.empty() : tensor<64x64xf32>
    %2 = linalg.fill ins(%cst_0 : f32) outs(%1 : tensor<64x64xf32>) -> tensor<64x64xf32>
    %3 = linalg.matmul ins(%arg0, %transposed : tensor<64x128xf32>, tensor<128x64xf32>) outs(%2 : tensor<64x64xf32>) -> tensor<64x64xf32>
    %4 = linalg.generic {indexing_maps = [#map, #map1, #map], iterator_types = ["parallel", "parallel"]} ins(%3, %cst_1 : tensor<64x64xf32>, tensor<64xf32>) outs(%1 : tensor<64x64xf32>) {
    ^bb0(%in: f32, %in_2: f32, %out: f32):
      %5 = arith.addf %in, %in_2 : f32
      linalg.yield %5 : f32
    } -> tensor<64x64xf32>
    return %4 : tensor<64x64xf32>
  }
}

